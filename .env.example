# ---------------------------------------------------------------------------
# Web2PDF configuration. Copy to `.env.local` and adjust as needed.
# Every value below has a safe built-in default; nothing here is a secret.
# ---------------------------------------------------------------------------

# Public origin of the app. Used to build absolute asset URLs in snapshots.
APP_URL=http://localhost:3000

# --- Browser selection ------------------------------------------------------
# "local"      -> full `playwright` package with a persistent warm browser.
#                 Correct for local dev and Docker/long-lived servers.
# "serverless" -> `playwright-core` + @sparticuz/chromium, launched per request.
#                 Required on Vercel / AWS Lambda. The binary is Linux-only.
# "auto"       -> serverless when a Vercel/Lambda env var is present, else local.
BROWSER_MODE=auto

# Optional: URL of a self-hosted chromium-pack.tar (brotli) for
# @sparticuz/chromium-min. Only needed when the full binary exceeds the
# platform bundle limit. Leave empty to use the bundled binary.
CHROMIUM_REMOTE_PACK_URL=

# --- Time limits (milliseconds) --------------------------------------------
# Hard ceiling for one full URL -> snapshot conversion.
MAX_PROCESSING_TIME_MS=120000
# Single navigation (goto) timeout.
BROWSER_TIMEOUT_MS=45000
# PDF rendering timeout, measured from print-layout to PDF bytes.
PDF_TIMEOUT_MS=60000
# Budget for the pagination fixpoint loop before accepting a degraded layout.
PAGINATION_BUDGET_MS=5000

# --- Size limits ------------------------------------------------------------
# Maximum serialized snapshot size. Larger pages are rejected with a clear error.
MAX_PAGE_SIZE_BYTES=12582912
# Maximum rendered page height in CSS pixels (guards infinite scroll).
MAX_PAGE_HEIGHT_PX=80000
# Maximum lazy-load scroll cycles before giving up on further growth.
MAX_SCROLL_ITERATIONS=40
# Images at or above this size are stored as session assets instead of
# being inlined as data URIs.
MAX_INLINE_IMAGE_BYTES=524288
# Single resource (image/font/stylesheet) size cap.
MAX_RESOURCE_BYTES=10485760

# --- Concurrency and sessions ----------------------------------------------
# Simultaneous browser jobs. Each costs roughly 300-500 MB of RAM.
MAX_CONCURRENT_JOBS=2
# Session lifetime with no activity, in milliseconds (default 30 minutes).
SESSION_TTL_MS=1800000
# Total memory budget across all live sessions; oldest are evicted first.
MAX_SESSION_STORE_BYTES=268435456

# --- Logging ----------------------------------------------------------------
# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# --- Testing only -----------------------------------------------------------
# Permits conversion of loopback/private addresses so the end-to-end suite can
# run against its local fixture server. NEVER set this in production: it
# disables the SSRF host policy that blocks internal network access.
ALLOW_PRIVATE_TARGETS=0
